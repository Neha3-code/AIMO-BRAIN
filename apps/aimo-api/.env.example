# Neon connection string (apps/aimo-api)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Real Valio Aimo Junction26 mock backend (server-side only — never forward
# this to the buyer-agent side).
AIMO_UPSTREAM_BASE_URL=https://junction26.valioaimo.fi
AIMO_UPSTREAM_API_KEY=junct_xxx

# Port the Fastify server listens on (Railway sets PORT automatically).
PORT=8080

# Comma-separated buyer-scoped API keys, format "key:buyer_id". Documented
# production path is OAuth2 client-credentials; this is the hackathon stand-in.
AIMO_BUYER_API_KEYS=demo-key-hotel-espoo:k-hotel-espoo,demo-key-canteen-turku:k-canteen-turku
