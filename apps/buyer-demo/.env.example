# Where apps/aimo-api is running.
AIMO_API_BASE_URL=http://localhost:8080

# This buyer-agent's own API key against the Aimo-side interface (must match
# an entry in apps/aimo-api's AIMO_BUYER_API_KEYS env var).
AIMO_API_KEY=demo-key-hotel-espoo
BUYER_ID=k-hotel-espoo

# Aimo AI proposal layer (AI search, seasonal suggestions, recipe planner): NVIDIA Nemotron 3.5
# Super VL on Verda, OpenAI-compatible. Without a key the app falls back to literal search and
# hides the AI panels' results. Never commit the real key.
VERDA_BASE_URL=https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1
VERDA_MODEL=nemotron-3.5-super-vl
VERDA_INFERENCE_KEY=
